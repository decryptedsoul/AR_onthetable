# Copy values into your shell environment or container configuration.
# Local defaults use backend/var/menu.db; no environment file loader is installed.
# Production: supply your own PostgreSQL database and password.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/coconut_grove
# Exact comma-separated origins only for a separately hosted frontend.
CORS_ORIGINS=
# Optional absolute path to a built React frontend.
# FRONTEND_DIR=/app/frontend/dist
